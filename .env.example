# ********** WNGSPAN ENVIRONMENT VARIABLES **********
#
# Legend:
#   [REQUIRED]     - App will not start or core features will break without this
#   [IF USED]      - Only needed if you enable that specific feature
#   [NOT NEEDED]   - Not used by WNGSPAN, safe to leave blank or remove
#
# ****************************************************

# - DATABASE ==========================================
# [REQUIRED]
DATABASE_URL="postgresql://postgres:@localhost:5450/calendso"
# [REQUIRED] Use the same as DATABASE_URL if not using a connection pooler (e.g. PgBouncer)
DATABASE_DIRECT_URL="postgresql://postgres:@localhost:5450/calendso"
# [NOT NEEDED] Only needed if using a separate analytics/insights database
INSIGHTS_DATABASE_URL=
# [NOT NEEDED] Only affects query chunking behavior; leave blank for default
DATABASE_CHUNK_SIZE=
# =====================================================

# - CORE / SHARED =====================================
# [REQUIRED] Set to http://app.cal.local:3000 if enabling organizations with subdomains
NEXT_PUBLIC_WEBAPP_URL='http://localhost:3000'
# [REQUIRED]
NEXT_PUBLIC_WEBSITE_URL='http://localhost:3000'
# [REQUIRED]
NEXT_PUBLIC_EMBED_LIB_URL='http://localhost:3000/embed/embed.js'
# [REQUIRED] Must match NEXT_PUBLIC_WEBAPP_URL
NEXTAUTH_URL='http://localhost:3000'
# [REQUIRED] Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# [NOT NEEDED] Only needed for cross-domain cookie auth (multi-domain setups)
NEXTAUTH_COOKIE_DOMAIN=
# [REQUIRED] Generate with: openssl rand -base64 24 (must be 32 bytes for AES256)
CALENDSO_ENCRYPTION_KEY=
# [REQUIRED]
CRON_API_KEY='0cc0e6c35519bba620c9360cfe3e68d0'
# [REQUIRED] Set to true to sync app metadata in the database
CRON_ENABLE_APP_SYNC=false
# [REQUIRED] Prefix for API keys generated by the app
API_KEY_PREFIX=cal_
# [REQUIRED] Force UTC timezone
TZ=UTC

# [REQUIRED] Define valid hostnames for the app
ALLOWED_HOSTNAMES='"cal.local:3000","localhost:3000"'
# [REQUIRED] Reserved subdomains that cannot be used by organizations
RESERVED_SUBDOMAINS='"app","auth","docs","design","console","go","status","api","saml","www","matrix","developer","cal","my","team","support","security","blog","learn","admin"'

# [NOT NEEDED] Cal.com telemetry — irrelevant for self-hosted WNGSPAN
CALCOM_TELEMETRY_DISABLED=
# =====================================================

# - BRANDING ==========================================
# [REQUIRED]
NEXT_PUBLIC_APP_NAME="WNGSPAN"
# [REQUIRED]
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS="support@wngspan.com"
# [REQUIRED]
NEXT_PUBLIC_COMPANY_NAME="WNGSPAN"
# [NOT NEEDED] Set to true to disable new user signups
NEXT_PUBLIC_DISABLE_SIGNUP=
# [NOT NEEDED] Custom privacy policy URL for self-hosters
NEXT_PUBLIC_WEBSITE_PRIVACY_POLICY_URL=
# [NOT NEEDED] Custom terms of service URL for self-hosters
NEXT_PUBLIC_WEBSITE_TERMS_URL=
# =====================================================

# - E-MAIL ============================================
# [REQUIRED] From address shown in outgoing emails
EMAIL_FROM='notifications@yourselfhostedcal.com'
# [REQUIRED]
EMAIL_FROM_NAME='WNGSPAN'
# [REQUIRED] SMTP host
EMAIL_SERVER_HOST='localhost'
# [REQUIRED] SMTP port
EMAIL_SERVER_PORT=1025
# Add EMAIL_SERVER_USER and EMAIL_SERVER_PASSWORD if your SMTP provider requires auth
# Example for Gmail:
# EMAIL_SERVER_HOST='smtp.gmail.com'
# EMAIL_SERVER_PORT=465
# EMAIL_SERVER_USER='<gmail_address>'
# EMAIL_SERVER_PASSWORD='<gmail_app_password>'

# [NOT NEEDED] Only needed for Sendgrid-based email delivery (WNGSPAN uses SMTP)
SENDGRID_API_KEY=
SENDGRID_EMAIL=
NEXT_PUBLIC_SENDGRID_SENDER_NAME=
# [NOT NEEDED] Sendgrid internal sync service
SENDGRID_SYNC_API_KEY=

# [NOT NEEDED] Payment reminder email timing override
AWAITING_PAYMENT_EMAIL_DELAY_MINUTES=
# [NOT NEEDED] Only for local E2E email testing with Mailhog
E2E_TEST_MAILHOG_ENABLED=
# =====================================================

# - GOOGLE ============================================
# [IF USED] Set GOOGLE_LOGIN_ENABLED=true and provide credentials to enable Google OAuth login
# and Google Calendar integration. Get credentials from Google Cloud Console.
# @see https://github.com/calcom/cal.diy#obtaining-the-google-api-credentials
GOOGLE_LOGIN_ENABLED=false
GOOGLE_API_CREDENTIALS=
# [IF USED] Required for Google Calendar holiday display
GOOGLE_CALENDAR_API_KEY=
# [IF USED] Required to verify incoming Google Calendar webhooks
GOOGLE_WEBHOOK_TOKEN=
# [NOT NEEDED] Override webhook tunnel URL (defaults to NEXT_PUBLIC_WEBAPP_URL)
GOOGLE_WEBHOOK_URL=
# =====================================================

# - MICROSOFT / OUTLOOK ===============================
# [IF USED] Set to true to enable Outlook/Microsoft calendar login
OUTLOOK_LOGIN_ENABLED=false
# [IF USED] Required to verify incoming Microsoft Calendar webhooks
MICROSOFT_WEBHOOK_TOKEN=
# [NOT NEEDED] Override webhook tunnel URL (defaults to NEXT_PUBLIC_WEBAPP_URL)
MICROSOFT_WEBHOOK_URL=
# =====================================================

# - ORGANIZATIONS =====================================
# [IF USED] Enable organizations feature. Requires a real domain (e.g. app.wngspan.com)
# Set to 1 or true in non-prod to test without a real domain
ORGANIZATIONS_ENABLED=
# [IF USED] Minimum seats for self-serve org creation
NEXT_PUBLIC_ORGANIZATIONS_MIN_SELF_SERVE_SEATS=30
# [IF USED] Price per seat for self-serve org creation
NEXT_PUBLIC_ORGANIZATIONS_SELF_SERVE_PRICE_NEW=37
# [NOT NEEDED] Auto-link sign-ups to orgs based on email domain
ORGANIZATIONS_AUTOLINK=

# [IF USED] Required to auto-create Vercel subdomains for orgs
# Get PROJECT_ID_VERCEL from: https://vercel.com/<TEAM>/<PROJECT>/settings
PROJECT_ID_VERCEL=
# Get TEAM_ID_VERCEL from: https://vercel.com/teams/<TEAM>/settings
TEAM_ID_VERCEL=
# Get AUTH_BEARER_TOKEN_VERCEL from: https://vercel.com/account/tokens
AUTH_BEARER_TOKEN_VERCEL=

# [NOT NEEDED] Cloudflare DNS management for org subdomains
# CLOUDFLARE_DNS=1
# AUTH_BEARER_TOKEN_CLOUDFLARE=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_VERCEL_CNAME=cname.vercel-dns.com
# =====================================================

# - STRIPE / BILLING ==================================
# [IF USED] Required if using Stripe for paid plans or payment collection on bookings
STRIPE_PRIVATE_KEY=
STRIPE_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_APPS=
STRIPE_WEBHOOK_SECRET_BILLING=
NEXT_PUBLIC_STRIPE_PRO_PLAN_PRICE=
NEXT_PUBLIC_STRIPE_PREMIUM_PLAN_PRICE=
NEXT_PUBLIC_IS_PREMIUM_NEW_PLAN=0
NEXT_PUBLIC_STRIPE_PREMIUM_NEW_PLAN_PRICE=
NEXT_PUBLIC_STRIPE_CREDITS_PRICE_ID=
STRIPE_TEAM_MONTHLY_PRICE_ID=
STRIPE_TEAM_ANNUAL_PRICE_ID=
STRIPE_TEAM_PRODUCT_ID=
STRIPE_ORG_MONTHLY_PRICE_ID=
STRIPE_ORG_ANNUAL_PRICE_ID=
STRIPE_ORG_PRODUCT_ID=
STRIPE_ORG_TRIAL_DAYS=
ORG_MONTHLY_CREDITS=
# [NOT NEEDED] Cal.ai voice agent phone number pricing — not used by WNGSPAN
STRIPE_PHONE_NUMBER_MONTHLY_PRICE_ID=
NEXT_PUBLIC_CAL_AI_PHONE_NUMBER_MONTHLY_PRICE=
# =====================================================

# - SENTRY (ERROR TRACKING) ===========================
# [IF USED] Sentry is bundled — set these to enable error reporting
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN_CLIENT=
SENTRY_DEBUG=
SENTRY_MAX_SPANS=
SENTRY_SAMPLE_RATE=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=
# =====================================================

# - PUSH NOTIFICATIONS ================================
# [IF USED] Enable browser push notifications
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# =====================================================

# - ANALYTICS (POSTHOG) ===============================
# [IF USED] Enable PostHog product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# =====================================================

# - URL SHORTENER =====================================
# [IF USED] Dub — used for referral program and SMS workflow link shortening
DUB_API_KEY=
NEXT_PUBLIC_DUB_PROGRAM_ID=
# [NOT NEEDED] Optional SMS-specific Dub settings
DUB_SMS_DOMAIN=
DUB_SMS_FOLDER_ID=
# [IF USED] Sink — alternative URL shortener to Dub
SINK_API_URL=
SINK_API_KEY=
# =====================================================

# - ASYNC TASKER (TRIGGER.DEV) ========================
# [IF USED] Enable async webhook/email processing via Trigger.dev
ENABLE_ASYNC_TASKER="false"
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_DEV_PROJECT_REF=
# [REQUIRED] Controls whether webhooks/emails run via the tasker
TASKER_ENABLE_WEBHOOKS=0
TASKER_ENABLE_EMAILS=0
# =====================================================

# - BOOKER / AVAILABILITY =============================
# [REQUIRED]
NEXT_PUBLIC_MINUTES_TO_BOOK=5
# [NOT NEEDED] Override days loaded in booker (0 = default)
NEXT_PUBLIC_BOOKER_NUMBER_OF_DAYS_TO_LOAD=0
# [NOT NEEDED] Override availability schedule interval
NEXT_PUBLIC_AVAILABILITY_SCHEDULE_INTERVAL=
# [NOT NEEDED] Reservation polling intervals
NEXT_PUBLIC_QUERY_RESERVATION_INTERVAL_SECONDS=
NEXT_PUBLIC_QUERY_RESERVATION_STALE_TIME_SECONDS=
NEXT_PUBLIC_QUERY_AVAILABLE_SLOTS_INTERVAL_SECONDS=
NEXT_PUBLIC_INVALIDATE_AVAILABLE_SLOTS_ON_BOOKING_FORM=0
NEXT_PUBLIC_QUICK_AVAILABILITY_ROLLOUT=10
# =====================================================

# - API V2 ============================================
# [REQUIRED] URL for internal API v2
NEXT_PUBLIC_API_V2_URL="http://localhost:5555/api/v2"
# =====================================================

# - LOGGING ===========================================
# [NOT NEEDED] Set to 3 to log info/warn/error/fatal. Default is fine for most setups.
# [0: silly, 1: trace, 2: debug, 3: info, 4: warn, 5: error+fatal, 6: fatal]
NEXT_PUBLIC_LOGGER_LEVEL=
# =====================================================

# - SECURITY / BOT PROTECTION =========================
# [NOT NEEDED] Cloudflare Turnstile — not wired into WNGSPAN
NEXT_PUBLIC_CLOUDFLARE_SITEKEY=
NEXT_PUBLIC_CLOUDFLARE_USE_TURNSTILE_IN_BOOKER=
CLOUDFLARE_TURNSTILE_SECRET=
# [NOT NEEDED] Vercel bot ID — not used
NEXT_PUBLIC_VERCEL_USE_BOTID_IN_BOOKER=
# [NOT NEEDED] Content security policy override
CSP_POLICY=
# [NOT NEEDED] Rate limiting via Unkey — not configured
UNKEY_ROOT_KEY=
# [NOT NEEDED] Blacklist specific emails from being added as booking guests
BLACKLISTED_GUEST_EMAILS=
# [NOT NEEDED] Content moderation via Iffy
IFFY_API_KEY=
# [NOT NEEDED] SAML SSO — enterprise feature, not used
SAML_DATABASE_URL=
SAML_ADMINS=
NEXT_PUBLIC_HOSTED_CAL_FEATURES=
PGSSLMODE=
# =====================================================

# - SCRIPT INJECTION ==================================
# [NOT NEEDED] Inject custom scripts into app pages
NEXT_PUBLIC_HEAD_SCRIPTS=
NEXT_PUBLIC_BODY_SCRIPTS=
# =====================================================

# - VERCEL EDGE CONFIG ================================
# [NOT NEEDED]
EDGE_CONFIG=
# =====================================================

# - AD TRACKING =======================================
# [NOT NEEDED] Google/LinkedIn ad conversion tracking
GOOGLE_ADS_ENABLED=1
LINKEDIN_ADS_ENABLED=1
# =====================================================

# - VIDEO RECORDING STORAGE ===========================
# [NOT NEEDED] S3 bucket for Daily Video recordings — not used by WNGSPAN
CAL_VIDEO_BUCKET_NAME=
CAL_VIDEO_BUCKET_REGION=
CAL_VIDEO_ASSUME_ROLE_ARN=
CAL_VIDEO_RECORDING_TOKEN_SECRET=
# [NOT NEEDED] Local testing override for Daily Video
CAL_VIDEO_MEETING_LINK_FOR_TESTING=
# =====================================================

# - SUPPORT CHAT WIDGETS ==============================
# [NOT NEEDED] Intercom
NEXT_PUBLIC_INTERCOM_APP_ID=
INTERCOM_SECRET=
INTERCOM_API_TOKEN=
# [NOT NEEDED] Zendesk
NEXT_PUBLIC_ZENDESK_KEY=
# [NOT NEEDED] Help Scout
NEXT_PUBLIC_HELPSCOUT_KEY=
# [NOT NEEDED] Fresh Chat
NEXT_PUBLIC_FRESHCHAT_TOKEN=
NEXT_PUBLIC_FRESHCHAT_HOST=
# [NOT NEEDED] Send feedback emails to an inbox
SEND_FEEDBACK_EMAIL=
# =====================================================

# - FORMBRICKS ========================================
# [NOT NEEDED] In-app surveys/feedback — not used by WNGSPAN
NEXT_PUBLIC_FORMBRICKS_HOST_URL=https://app.formbricks.com
NEXT_PUBLIC_FORMBRICKS_ENVIRONMENT_ID=
FORMBRICKS_FEEDBACK_SURVEY_ID=
# =====================================================

# - AVATAR API ========================================
# [NOT NEEDED] Pre-fills avatar during signup — not used by WNGSPAN
AVATARAPI_USERNAME=
AVATARAPI_PASSWORD=
# =====================================================

# - SMS / TWILIO ======================================
# [NOT NEEDED] SMS workflows via Twilio — not configured for WNGSPAN
NEXT_PUBLIC_SENDER_ID=
TWILIO_VERIFY_SID=
TWILIO_OPT_OUT_ENABLED=
# =====================================================

# - RETELL AI (VOICE AGENTS) ==========================
# [NOT NEEDED] Cal.ai voice agent feature — not used by WNGSPAN
RETELL_AI_KEY=
RETELL_AI_TEST_MODE=false
RETELL_AI_TEST_EVENT_TYPE_MAP=
RETELL_AI_TEST_CAL_API_KEY=
CAL_AI_CALL_RATE_PER_MINUTE=0.29
# =====================================================

# - HUDDLE01 ==========================================
# [NOT NEEDED] Huddle01 video integration — not used by WNGSPAN
HUDDLE01_API_TOKEN=
# =====================================================

# - CLOSE.COM CRM =====================================
# [NOT NEEDED] Internal CRM — not used by WNGSPAN
CLOSECOM_CLIENT_ID=
CLOSECOM_CLIENT_SECRET=
# =====================================================

# - LINGO.DEV (AI LOCALIZATION) =======================
# [NOT NEEDED] Real-time AI localization — not used by WNGSPAN
LINGO_DOT_DEV_API_KEY=
# =====================================================

# - SALESFORCE ========================================
# [NOT NEEDED] Salesforce integration — not used by WNGSPAN
SALESFORCE_GRAPHQL_DELAY_MS=500
SALESFORCE_GRAPHQL_MAX_DELAY_MS=2000
SALESFORCE_GRAPHQL_MAX_RETRIES=3
# =====================================================

# - SCIM / DIRECTORY SYNC =============================
# [NOT NEEDED] Debug logging for SCIM API requests
DIRECTORY_IDS_TO_LOG=
# =====================================================

# - SINGLE ORG MODE ===================================
# [NOT NEEDED] Only needed if WNGSPAN serves one org's booking pages exclusively
NEXT_PUBLIC_SINGLE_ORG_SLUG=
# =====================================================

# - CREDENTIAL SYNC ===================================
# [NOT NEEDED] Only for embedding cal.diy into another app that has its own integrations
CALCOM_CREDENTIAL_SYNC_SECRET=""
CALCOM_CREDENTIAL_SYNC_HEADER_NAME="calcom-credential-sync-secret"
CALCOM_CREDENTIAL_SYNC_ENDPOINT=""
CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY=""
# =====================================================

# - SERVICE ACCOUNT ENCRYPTION ========================
# [NOT NEEDED] Encrypt/decrypt service account keys — not used by WNGSPAN
# Generate with: openssl rand -base64 24
CALCOM_SERVICE_ACCOUNT_ENCRYPTION_KEY=
# =====================================================

# - E2E TESTING =======================================
# [NOT NEEDED] All vars below are only for automated E2E test runs
NEXT_PUBLIC_IS_E2E=
E2E_TEST_APPLE_CALENDAR_EMAIL=""
E2E_TEST_APPLE_CALENDAR_PASSWORD=""
E2E_TEST_CALCOM_QA_EMAIL="qa@example.com"
E2E_TEST_CALCOM_QA_PASSWORD="password"
E2E_TEST_CALCOM_QA_GCAL_CREDENTIALS=
E2E_TEST_CALCOM_GCAL_KEYS=
# =====================================================

# - PLATFORM OAUTH SEEDING ============================
# [NOT NEEDED] Only for seeding platform example apps
SEED_PLATFORM_OAUTH_CLIENT_ID=
SEED_PLATFORM_OAUTH_CLIENT_SECRET=
SEED_OAUTH2_CLIENT_ID=
SEED_OAUTH2_CLIENT_SECRET_HASHED=
# =====================================================
